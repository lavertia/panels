<?php

declare(strict_types=1);

namespace App\Providers\Lavertia;

use Lavertia\Panels\Panel;
use Lavertia\Panels\PanelProvider;

final class {{ class }} extends PanelProvider
{
    public function panel(Panel $panel): Panel
    {
        return $panel
            ->id('{{ id }}')
            ->path('{{ id }}')
            ->brandName(config('app.name', 'Lavertia'))
            ->brandSubtitle('Administration')
            ->primaryColor('#f59e0b')
            ->sidebarVariant('inset')
            ->sidebarCollapsible()
            ->sidebarWidth('18rem')
            ->themeMode('system')
            ->contentWidth('full')
            ->navigationPosition('sidebar')
            ->topbar()
            ->breadcrumbs()
            ->mobileNavigation()
            ->discoverPages(app_path('Lavertia/Pages'), 'App\\Lavertia\\Pages');
    }
}
