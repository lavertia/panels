{
  "name": "lavertia/panels",
  "description": "Composable Inertia panels for Laravel Starter Kits (React, Vue and Svelte).",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0 || ^13.0",
    "inertiajs/inertia-laravel": "^3.0",
    "lavertia/support": "^0.1",
    "lavertia/forms": "^0.2",
    "lavertia/tables": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "Lavertia\\Panels\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "laravel/pint": "^1.27"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lavertia\\Panels\\PanelsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "test:smoke": "@php -d zend.assertions=1 -d assert.exception=1 tests/smoke.php",
    "lint": "@php vendor/bin/pint --test"
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Inventory\\": "tests/Fixtures/app-modules/inventory/src/"
    }
  }
}
